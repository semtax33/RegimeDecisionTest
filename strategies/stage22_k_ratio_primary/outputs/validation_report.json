  "feature_policy": {
    "k_ratio": "126-daily-observation Kestner-1996 slope / (slope standard error * sqrt(n)) on log price",
    "k_score": "k_ratio / (1 + abs(k_ratio))",
    "atr": "Wilder ATR(14), normalized by close",
    "atr_normalization": "causal expanding percentile per asset",
    "price_strength_equity": "Wilder price RSI(14), mapped by (RSI-50)/50",
    "volume_strength_equity": "Wilder-smoothed up-volume share RSI(14), mapped by (RSI-50)/50",
    "equity_rsi_confirmation": "clip((1 + sign(k_score) * mean(price_strength, volume_strength)) / 2, 0, 1)",
    "equity_technical_direction": "k_score * rsi_confirmation",
    "other_asset_technical_direction": "k_score",
    "macro_confidence": "(1 + sign(macro_mu-neutral_mu) * technical_direction) / 2",
    "filtered_macro_mu": "neutral_mu + confidence * (macro_mu-neutral_mu)",
    "atr_covariance": "D @ Sigma @ D where D_i=sqrt(1+causal_ATR_percentile_i)",
